# ---------------------------------------------------------------------------
# Artha-Kosha — every value here is a placeholder. Never commit real secrets.
# Locally, copy to .env.local. On Vercel, set the same names (all Sensitive
# except the NEXT_PUBLIC_* ones, which ship to the browser by design).
# ---------------------------------------------------------------------------

# --- Server: Firebase Admin SDK -------------------------------------------
# Base64 of the service-account JSON, or the raw JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=artha-kosha-dev

# --- Server: the single owner ---------------------------------------------
OWNER_EMAIL=owner@example.com

# --- Browser: Firebase web config (public by design) ----------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=artha-kosha-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=artha-kosha-dev
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com

# --- Local development only -----------------------------------------------
# "true" connects the client + admin SDKs to the Firebase Emulator Suite and
# lets the app run with no GCP project at all. For a REAL project, set this to
# "false" and delete both FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST
# lines entirely — either one being present still routes the Admin SDK to the
# emulator. The emulators also need a JDK; a real project does not.
NEXT_PUBLIC_USE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Server: integrations (M3+) -------------------------------------------
# Google Cloud -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorised redirect URI, exactly: <your-origin>/api/ingest/gmail/callback
# Scope requested: gmail.readonly + openid email (External, Testing is fine).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Seals the Gmail refresh tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENC_KEY=
# Phone -> /api/ingest/sms. Sent as the x-webhook-secret header, an
# Authorization: Bearer header, or the app's HMAC-SHA256 X-Signature.
SMS_WEBHOOK_SECRET=
# Cloud Scheduler -> GET /api/cron/sync, Authorization: Bearer <this value>.
CRON_SECRET=
BACKUP_BUCKET=artha-kosha-backups
