rules_version = '2';

// Artha-Kosha: the browser has ZERO Firestore access.
//
// Every read and write goes through the Next.js server, which holds the only
// credential (the Admin SDK service account). The Admin SDK bypasses these
// rules entirely, so a stolen browser session, a leaked project id, or a
// copied URL cannot read a single rupee of this ledger.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
